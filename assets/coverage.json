    "source_file": "assets/sources/live-interface.json",
    "event_catalog": "assets/interfaces/auction-events.json",
    "reference": "references/auction-history.md",
    "scope": "Bounded legacy and v1.1 license history plus charter history, preserving chain/address/generation/round identity; not the current auction-status path",
    "limits": [
      "The fixed history helper reads authenticated events on demand with hard coverage budgets; it does not persist observations, generate performance recaps or expand its eth_call surface. These helper limits do not prohibit requested historical analysis or host-authorized artifacts.",
      "Round IDs do not establish duration; roll inclusion time does not establish scheduled opening. Historical caps and settings cannot be replaced with present values.",
      "Purchase-event accounting is distinct from independently reconciled payments; incomplete logs, archive failure and empty responses are not complete zero history.",
      "No dedicated reviewed sellout/end event or independent auction source/bytecode equivalence is established.",
      "Do not merge reused round IDs across license generations or drop legacy history. Current availability uses direct getters, never rediscovery, reindexing or log reconstruction."
    ]
  },
