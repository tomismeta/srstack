  "market_price": {
    "source_ids": [
      "dexscreener-api",
      "geckoterminal-api"
    ],
    "path": "scripts/price.py",
    "identity_catalog": "assets/entities/robinhood.json",
    "scope": "Canonical-pool prices with DEX Screener primary, labelled GeckoTerminal availability fallback, optional cross-check and single-provider gross valuation",
    "limits": [
      "Separate from block-scoped RPC snapshots; provider quote-observation time is unavailable.",
      "The fixed price helper does not average provider prices or mix valuation denominations; identity, schema and access failures are not concealed by fallback. Requested supplemental provider comparisons or models must identify sources and methods.",
      "Indicative current prices do not establish future prices.",
      "Gross accrued-balance marks are not net withdrawal proceeds or charter market values."
    ]
  },
  "auction_history": {
    "source_ids": [
      "sr-auction-event-interface",
      "sr-v1-1-deployment-evidence",
      "sr-v1-1-read-interface"
