{
  "schema_version": 1,
  "purpose": "Current-only source routing; no superseded claims or competing interpretation archive",
  "groups": [
    {
      "id": "website-v1",
      "path": "assets/sources/website-v1.json",
      "record_ids": [
        "sr-whitepaper-v1",
        "sr-token-page-v1",
        "sr-charters-page-v1"
      ],
      "scope": "Current primary whitepaper and companion pages"
    },
    {
      "id": "deployments",
      "path": "assets/sources/deployments.json",
      "record_ids": [
        "sr-contract-directory",
        "sr-etherscan-chainlist",
        "sr-protocol-conditions"
      ],
      "scope": "Current attribution, routing and conditions"
    },
    {
      "id": "etherscan",
      "path": "assets/sources/etherscan.json",
      "record_ids": [
        "sr-etherscan-standard",
        "sr-etherscan-charter-nft",
        "sr-etherscan-central-bank",
        "sr-etherscan-tax-hook",
        "sr-etherscan-genesis-minter",
        "sr-etherscan-charter-auction",
        "sr-etherscan-license-auction",
        "sr-etherscan-expansion-vault",
        "sr-etherscan-contraction-vault",
        "sr-etherscan-pol-manager",
        "sr-etherscan-fee-splitter",
        "sr-etherscan-registry",
        "sr-etherscan-pool-manager",
        "sr-etherscan-multicall3"
      ],
      "scope": "Current explorer source-publication evidence"
    }
  ],
  "lookup": "Match source ID to groups.record_ids and read the literal path.",
  "rules": [
    "Source and retrieval dates qualify every observation; current-only does not mean live.",
    "Use original source URLs and record scope. Exact canonical parameters live in assets/parameters.json.",
    "Unavailable or unresolved implementation details remain not-established; never select a value merely to fill a gap."
  ]
}
